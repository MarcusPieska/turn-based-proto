#!/bin/bash
set -e
cd "$(dirname "$0")"
ROOT="../.."
LIB_SO="$ROOT/data_io/runtime_static_loader_lib.so"
LOG_SO="$ROOT/log_dbg/log_dbg.so"
if [ ! -f "$LIB_SO" ]; then
    echo "missing $LIB_SO - run ../../data_io/runtime_static_loader_lib_comp first"
    exit 1
fi
if [ ! -f "$LOG_SO" ]; then
    echo "missing $LOG_SO - run ../../log_dbg/log_dbg_comp first"
    exit 1
fi

INC="-I.. \
     -I$ROOT \
     -I$ROOT/game \
     -I$ROOT/misc \
     -I$ROOT/data_io \
     -I$ROOT/static_state \
     -I$ROOT/city \
     -I$ROOT/city/assessor \
     -I$ROOT/city/effector \
     -I$ROOT/dyn_state \
     -I$ROOT/gen_bit_banks \
     -I$ROOT/ai_pathing/walk_general \
     -I$ROOT/ai_pathing/walk_cities \
     -I$ROOT/ai_proc \
     -I$ROOT/map_loader \
     -I$ROOT/simple_map_gen \
     -I$ROOT/log_dbg"
CXXFLAGS="-std=c++17 -Wall -Wextra"

# shellcheck source=eval_save_link.inc
source ./eval_save_link.inc
compile_eval_save_deps

g++ $CXXFLAGS $INC -c ../eval_paths.cpp -o eval_paths.o
g++ $CXXFLAGS $INC -c ../eval_need.cpp -o eval_need.o
g++ $CXXFLAGS $INC -c ../eval_bin_light.cpp -o eval_bin_light.o
g++ $CXXFLAGS $INC -c ../eval_log.cpp -o eval_log.o
g++ $CXXFLAGS $INC -c ../eval_driver.cpp -o eval_driver.o
g++ $CXXFLAGS $INC -c ../draw_map_tile_ownership.cpp -o draw_map_tile_ownership.o
g++ $CXXFLAGS $INC -c ../map_own_save_snap.cpp -o map_own_save_snap.o
g++ $CXXFLAGS $INC -c "$ROOT/misc/whiteboard_mng.cpp" -o whiteboard_mng.o
g++ $CXXFLAGS $INC -c border_turn_handler_tester.cpp -o border_turn_handler_tester.o

run_mk () {
    local mk="$1"
    local impl="impl/border_turn_handler_impl_${mk}.cpp"
    echo "--- build/run border_turn_handler ${mk} ---"
    g++ $CXXFLAGS $INC \
        -DBORDER_TURN_HANDLER_IMPL="\"${impl}\"" \
        -c "$ROOT/ai_proc/border_turn_handler.cpp" -o border_turn_handler.o
    g++ $CXXFLAGS -o border_turn_handler_tester \
        $EVAL_SAVE_DEP_OBJS \
        eval_paths.o eval_need.o eval_bin_light.o eval_log.o eval_driver.o \
        draw_map_tile_ownership.o map_own_save_snap.o whiteboard_mng.o \
        border_turn_handler.o border_turn_handler_tester.o \
        -ldl \
        $LIB_SO \
        $LOG_SO \
        -Wl,-rpath,'$ORIGIN/../../data_io' \
        -Wl,-rpath,'$ORIGIN/../../log_dbg' \
        -Wl,--allow-shlib-undefined \
        -lm
    BORDER_MK="$mk" ./border_turn_handler_tester
}

MKS="${*:-mk06}"
for mk in $MKS; do
    run_mk "$mk"
done

rm_eval_save_deps
rm -f eval_paths.o eval_need.o eval_bin_light.o eval_log.o eval_driver.o \
    draw_map_tile_ownership.o map_own_save_snap.o whiteboard_mng.o \
    border_turn_handler.o border_turn_handler_tester.o
