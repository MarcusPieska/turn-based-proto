#!/bin/bash

INC="-I. -I.. -I../misc -I../static_state"

g++ $INC -c ../misc/static_string_pool.cpp -o static_string_pool.o
g++ $INC -c ../static_state/trait_affinity_map.cpp -o trait_affinity_map.o
