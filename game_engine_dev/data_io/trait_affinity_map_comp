    static_string_pool.o \
    trait_affinity_map.o \
    opt_str_mng.o \
    path_mng.o \
    item_effect_handler.o \
    item_effect_helpers.o \
    data_parser_base.o \
    civ_trait_parser.o \
    trait_affinity_map_parsing.o \
    trait_affinity_map_tester.o
