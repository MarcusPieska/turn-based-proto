#!/bin/bash

set -e

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

source p1_build_core_map_objs.sh

INC="-I. -I.. -I../map_loader -I../static_state -I../misc -I../res_dist -I../data_io -I../simple_map_gen -I../ai_pathing/walk_general -I../city -I../city/effector -I../gen_bit_banks -I../game"

g++ -std=c++11 $INC -c p1_proc_distributed_coastal_points_tester.cpp -o p1_proc_distributed_coastal_points_tester.o

g++ -std=c++11 -o p1_proc_distributed_coastal_points_tester \
    $CORE_MAP_OBJS \
    p1_proc_distributed_coastal_points_tester.o \
    -ldl \
    ../data_io/runtime_static_loader_lib.so \
    -Wl,-rpath,'$ORIGIN/../data_io' -lm

rm $CORE_MAP_OBJS p1_proc_distributed_coastal_points_tester.o
