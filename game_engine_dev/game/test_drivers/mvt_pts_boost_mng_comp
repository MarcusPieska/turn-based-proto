#!/bin/bash
set -e

cd "$(dirname "$0")"

LIB_SO="../../data_io/runtime_static_loader_lib.so"
if [ ! -f "$LIB_SO" ]; then
    echo "missing $LIB_SO - run ../../data_io/runtime_static_loader_lib_comp first"
    exit 1
fi

INC="-I../.. \
     -I../../misc \
     -I../../data_io \
     -I../../static_state \
     -I../../city \
     -I../../city/assessor \
     -I../../city/effector \
     -I../../dyn_state \
     -I../../gen_bit_banks \
     -I../../map_loader \
     -I../../ai_pathing/walk_general \
     -I../../ai_pathing/walk_cities \
     -I../../ai_pathing/walk_target \
     -I../../ai_proc \
     -I.."
CXXFLAGS="-std=c++17 -Wall -Wextra"

g++ $CXXFLAGS $INC -c ../../data_io/runtime_static_loader.cpp -o runtime_static_loader.o
g++ $CXXFLAGS $INC -c ../../misc/bit_array.cpp -o bit_array.o
g++ $CXXFLAGS $INC -c ../../city/effector/booster_effect_register.cpp -o booster_effect_register.o
g++ $CXXFLAGS $INC -c ../../city/effector/effect_enabler.cpp -o effect_enabler.o
g++ $CXXFLAGS $INC -c ../../city/effector/dyn_booster_register.cpp -o dyn_booster_register.o
g++ $CXXFLAGS $INC -c ../resource_ledger.cpp -o resource_ledger.o
g++ $CXXFLAGS $INC -c ../mvt_pts_boost_mng.cpp -o mvt_pts_boost_mng.o
g++ $CXXFLAGS $INC -c mvt_pts_boost_mng_tester.cpp -o mvt_pts_boost_mng_tester.o

g++ $CXXFLAGS -o mvt_pts_boost_mng_tester \
    runtime_static_loader.o \
    bit_array.o \
    booster_effect_register.o \
    effect_enabler.o \
    dyn_booster_register.o \
    resource_ledger.o \
    mvt_pts_boost_mng.o \
    mvt_pts_boost_mng_tester.o \
    -ldl \
    $LIB_SO \
    -Wl,-rpath,'$ORIGIN/../../data_io' \
    -Wl,--allow-shlib-undefined

echo "--- running mvt_pts_boost_mng_tester ---"
./mvt_pts_boost_mng_tester

rm -f runtime_static_loader.o bit_array.o booster_effect_register.o effect_enabler.o \
    dyn_booster_register.o resource_ledger.o mvt_pts_boost_mng.o mvt_pts_boost_mng_tester.o
