#!/bin/bash
set -e

cd "$(dirname "$0")"
ROOT="../.."
LIB_SO="$ROOT/data_io/runtime_static_loader_lib.so"
LOG_SO="$ROOT/log_dbg/log_dbg.so"
if [ ! -f "$LIB_SO" ]; then
    echo "missing $LIB_SO - run ../../data_io/runtime_static_loader_lib_comp first"
    exit 1
fi
if [ ! -f "$LOG_SO" ]; then
    echo "missing $LOG_SO - run ../../log_dbg/log_dbg_comp first"
    exit 1
fi

INC="-I. \
     -I.. \
     -I$ROOT \
     -I$ROOT/misc \
     -I$ROOT/map_loader \
     -I$ROOT/simple_map_gen \
     -I$ROOT/data_io \
     -I$ROOT/static_state \
     -I$ROOT/dyn_state \
     -I$ROOT/game \
     -I$ROOT/city \
     -I$ROOT/city/assessor \
     -I$ROOT/city/effector \
     -I$ROOT/gen_bit_banks \
     -I$ROOT/adv_map_gen \
     -I$ROOT/ai_pathing/walk_general \
     -I$ROOT/ai_pathing/walk_cities \
     -I$ROOT/ai_pathing/walk_target \
     -I$ROOT/ai_proc \
     -I$ROOT/game_eval \
     -I$ROOT/log_dbg \
     -I$ROOT/gen_effector"
CXXFLAGS="-std=c++17 -Wall -Wextra -ffunction-sections -fdata-sections"

# shellcheck source=../../game_eval/test_drivers/eval_save_link.inc
source ../../game_eval/test_drivers/eval_save_link.inc
compile_eval_save_deps

g++ $CXXFLAGS $INC -c "$ROOT/misc/whiteboard_mng.cpp" -o whiteboard_mng.o
g++ $CXXFLAGS $INC -c "$ROOT/misc/assert_log.cpp" -o assert_log.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/fort_add_vector.cpp" -o fort_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/mine_add_vector.cpp" -o mine_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/monastery_add_vector.cpp" -o monastery_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/outpost_add_vector.cpp" -o outpost_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/plantation_add_vector.cpp" -o plantation_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/shipyard_add_vector.cpp" -o shipyard_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/dyn_state/trade_post_add_vector.cpp" -o trade_post_add_vector.o
g++ $CXXFLAGS $INC -c "$ROOT/game/combat_mods.cpp" -o combat_mods.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_general/sector_network.cpp" -o sector_network.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_general/sector_network_router.cpp" -o sector_network_router.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_cities/city_network.cpp" -o city_network.o
g++ $CXXFLAGS $INC -c "$ROOT/game_eval/test_drivers/player_muster_gen_ai_stubs.cpp" -o player_muster_gen_ai_stubs.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_target/walk_p2p.cpp" -o walk_p2p.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_target/generate_distance_p2p.cpp" -o generate_distance_p2p.o
g++ $CXXFLAGS $INC -c "$ROOT/ai_pathing/walk_target/generate_access_mask.cpp" -o generate_access_mask.o
g++ $CXXFLAGS $INC -c "$ROOT/game_eval/draw_map_tile_ownership.cpp" -o draw_map_tile_ownership.o
g++ $CXXFLAGS $INC -c "$ROOT/game_eval/eval_paths.cpp" -o eval_paths.o
g++ $CXXFLAGS $INC -c ../city_muster_grad.cpp -o city_muster_grad.o
g++ $CXXFLAGS $INC -c city_muster_grad_tester.cpp -o city_muster_grad_tester.o

GS_EXTRA_OBJS="whiteboard_mng.o assert_log.o fort_add_vector.o mine_add_vector.o \
    monastery_add_vector.o outpost_add_vector.o plantation_add_vector.o shipyard_add_vector.o \
    trade_post_add_vector.o combat_mods.o sector_network.o sector_network_router.o city_network.o \
    player_muster_gen_ai_stubs.o walk_p2p.o generate_distance_p2p.o generate_access_mask.o \
    draw_map_tile_ownership.o eval_paths.o city_muster_grad.o city_muster_grad_tester.o"

g++ $CXXFLAGS -o city_muster_grad_tester \
    $GS_EXTRA_OBJS \
    $EVAL_SAVE_DEP_OBJS \
    -ldl \
    $LIB_SO \
    $LOG_SO \
    -Wl,-rpath,'$ORIGIN/../../data_io' \
    -Wl,-rpath,'$ORIGIN/../../log_dbg' \
    -Wl,--allow-shlib-undefined \
    -Wl,--allow-multiple-definition \
    -Wl,--gc-sections

echo "--- running city_muster_grad_tester ---"
./city_muster_grad_tester
rm_eval_save_deps
rm -f $GS_EXTRA_OBJS city_muster_grad_tester
